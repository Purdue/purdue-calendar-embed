{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "purdue/calendar",
  "version": "1.0.2",
  "title": "Purdue Calendar",
  "category": "widgets",
  "description": "Renders Localist events from the events.purdue.edu RSS feed, or embeds a Localist widget.",
  "keywords": [
    "events",
    "calendar",
    "localist"
  ],
  "textdomain": "purdue-calendar-embed",
  "supports": {
    "html": false
  },
  "attributes": {
    "mode": {
      "type": "string",
      "default": "feed"
    },
    "feedUrl": {
      "type": "string",
      "default": "https://events.purdue.edu/calendar.xml"
    },
    "eventTypes": {
      "type": "string",
      "default": ""
    },
    "experience": {
      "type": "string",
      "default": ""
    },
    "count": {
      "type": "number",
      "default": 5
    },
    "windowDays": {
      "type": "number",
      "default": 90
    },
    "hidePast": {
      "type": "boolean",
      "default": true
    },
    "layout": {
      "type": "string",
      "default": "list"
    },
    "headingLevel": {
      "type": "number",
      "default": 3
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "showDescription": {
      "type": "boolean",
      "default": true
    },
    "showCategory": {
      "type": "boolean",
      "default": true
    },
    "widgetUrl": {
      "type": "string",
      "default": ""
    },
    "widgetSnippet": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}