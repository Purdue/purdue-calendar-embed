{
    "name": "purdue/purdue-calendar-embed",
    "description": "Gutenberg block that renders Localist events from the events.purdue.edu RSS feed",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Purdue Marketing and Communications",
            "email": "digital-marketing@groups.purdue.edu",
            "homepage": "https://marcom.purdue.edu"
        }
    ],
    "support": {
        "email": "digital-marketing@groups.purdue.edu",
        "issues": "https://github.com/Purdue/purdue-calendar-embed/issues",
        "source": "https://github.com/Purdue/purdue-calendar-embed"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^3.6",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Purdue\\CalendarEmbed\\": "src/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyze": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
